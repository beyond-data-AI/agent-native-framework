{
  "name": "@agent-native/docs",
  "private": true,
  "bugs": {
    "url": "https://github.com/BuilderIO/agent-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BuilderIO/agent-native",
    "directory": "packages/docs"
  },
  "type": "module",
  "scripts": {
    "dev": "agent-native dev --port 3000",
    "codemod:docs-blocks": "tsx scripts/codemod-doc-blocks.ts --dry-run",
    "codemod:docs-blocks:write": "tsx scripts/codemod-doc-blocks.ts --write",
    "generate-source-index": "tsx scripts/generate-source-index.ts",
    "validate-doc-blocks": "vitest run app/components/docBlocks.validate.test.tsx",
    "prebuild": "tsx scripts/generate-source-index.ts && vitest run app/components/docBlocks.validate.test.tsx",
    "build": "agent-native build",
    "start": "agent-native start",
    "typecheck": "agent-native typecheck",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agent-native/core": "workspace:*",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-router/dev": "^8.5.0",
    "@react-router/fs-routes": "^8.5.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "gray-matter": "^4.0.3",
    "h3": "catalog:",
    "isbot": "^5.2.2",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.12"
  },
  "agent-native": {
    "workspaceApp": {
      "audience": "public",
      "agentWeb": {
        "discoverable": true,
        "markdownTwins": true,
        "llmsTxt": true,
        "jsonLd": true,
        "publicAgentCard": true,
        "publicMcp": false,
        "crawlerPolicy": "discoverable-no-training"
      }
    }
  }
}
